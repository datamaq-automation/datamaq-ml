# Copiar a .env para sobreescribir valores por defecto (el .env es local y no se versiona).
# Los valores por defecto están en src/infrastructure/settings/config.py.
# Este archivo NO debe contener secretos: el acceso a la VPS va en ~/.ssh/config.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Fuente de mediciones: local (data/input/<medidor>.csv) o ssh (descarga desde la VPS).
MEDICIONES_SOURCE=local

# Rutas (relativas a la raíz del repo)
#MEDICIONES_CSV_DIR=data/input
#MEDICIONES_CACHE_DIR=data/prod-cache
#RESULTADOS_DIR=data/output
#VERDAD_DIR=data/verdad
#MODELOS_DIR=data/models

# NILM: dejar comentado para usar los valores automáticos
#NILM_UMBRAL_KW=60
#NILM_EPS_KW=
#NILM_MIN_EVENTOS=
#NILM_SEPARACION_MINIMA=0.8
#NILM_BALANCE_MINIMO=0.5
