# Entornos virtuales
.venv/
venv/
env/
ENV/

# Python cachés y compilados
__pycache__/
*.py[cod]
*.class
.pytest_cache/
.coverage
htmlcov/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Base de datos local SQLite
*.db
*.sqlite3

# Editores e IDEs
.vscode/
.idea/
*.swp
*.swo
# Scripts locales de extracción (no versionados)
tmp/
# Resultados del entrenamiento: los genera cada alumno
data/output/*
!data/output/.gitkeep

# Modelos serializados (joblib)
data/models/*
!data/models/.gitkeep

# Cache de mediciones descargadas desde VPS (modo prod)
data/prod-cache/*
!data/prod-cache/.gitkeep

# Mediciones reales de planta y symlinks a ellas (no se versionan: ver README).
# Solo el dataset sintético (generado por `./run.sh simulate`) queda versionado.
data/input/*
!data/input/.gitkeep
!data/input/sintetico.csv
data/verdad/*
!data/verdad/sintetico.csv

# Logs de ejecución
*.log
